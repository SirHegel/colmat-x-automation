# Catálogo de variables para desarrollo; no lo copies completo a producción.
# OpenClaw orquesta tres command jobs con tres archivos 0600 separados y fuera del checkout:
# - automation-worker.env: PostgreSQL/Telegram, MiniMax y X;
# - generation-worker.env: PostgreSQL/Telegram y MiniMax, nunca X;
# - publication-worker.env: PostgreSQL y X, nunca MiniMax.

# La publicación real necesita los cuatro valores OAuth 1.0a de la cuenta de Colmat.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
EXPECTED_X_USERNAME=
EXPECTED_X_USER_ID=

# Base compartida para usuarios, roles, auditoría y webhooks. En Vercel debe ser PostgreSQL.
DATABASE_URL=

# Telegram: usa el gestor de secretos del entorno.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Presupuesto de red del plano web/serverless; los workers usan su propio timeout.
COLMAT_WEB_TELEGRAM_TIMEOUT_SECONDS=3

# Sesiones web passwordless. Genera al menos 32 caracteres aleatorios y configúrala en Vercel;
# no se comparte con los workers ni se persiste en la base.
WEB_AUTH_PEPPER=

# MiniMax solo vive en los workers auditados de generación; no lo configures en Vercel.
# La clave real puede llegar por un EnvironmentFile 0600 de systemd, limitado a automation y
# generation. En ese caso omite MINIMAX_API_KEY de sus envs; nunca la copies al repositorio ni al
# env de publication.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_IMAGE_MODEL=image-01
COLMAT_GENERATION_ENABLED=false
COLMAT_GENERATION_DEFAULT_IMAGE=true

# La publicación direct exige simultáneamente ambas variables y --live.
COLMAT_LIVE_ENABLED=false
COLMAT_DIRECT_PUBLISH_ENABLED=false

# Identidades de servicio de mínimo privilegio para el worker fijo de OpenClaw.
COLMAT_AUTOMATION_SCHEDULER_ID=
COLMAT_AUTOMATION_AUTHOR_ID=
COLMAT_AUTOMATION_REVIEWER_ID=
COLMAT_AUTOMATION_PUBLISHER_ID=
COLMAT_TELEGRAM_ALERT_CHAT_ID=
COLMAT_TELEGRAM_REVIEWER_USER_ID=
# Raíz común del host persistente. Ambas variables deben ser idénticas. Se aceptan solo los
# perfiles project/user/system o sus rutas canónicas exactas; este valor equivale a system.
COLMAT_AUTOMATION_MEDIA_ROOT=/var/lib/colmat-x/media
COLMAT_GENERATION_MEDIA_ROOT=/var/lib/colmat-x/media

# Los tres envs empiezan con gates false y sus jobs de OpenClaw se crean deshabilitados. MiniMax
# solo propone; las imágenes y el modo direct permanecen bajo revisión humana por defecto.

# Opcionales.
COLMAT_CONFIG=config/colmat.yaml
# En local se usa .state/colmat.db; el servicio admite solo /var/lib/colmat-x/.
# COLMAT_STATE_DB=/var/lib/colmat-x/colmat.db
